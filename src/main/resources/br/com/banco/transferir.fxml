<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<?import java.lang.String?>
<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.banco.screen.TransferirController">
   <children>
      <VBox layoutX="200.0" layoutY="100.0" prefHeight="200.0" prefWidth="100.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <VBox>
               <children>
                  <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="40.0">
                     <children>
                        <Label text="CPF">
                           <font>
                              <Font name="Comic Sans MS Bold" size="20.0" />
                           </font>
                        </Label>
                        <TextField fx:id="text_cpf" minWidth="-Infinity" prefWidth="300.0" />
                        <Button onAction="#buscar" fx:id="btn_buscar" mnemonicParsing="false" text="Buscar" >
                            <styleClass>
                                <String fx:value="btn" />
                                <String fx:value="btn-sm" />
                            </styleClass>
                        </Button>

                     </children>
                     <padding>
                        <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                     </padding>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="20.0">
                     <children>
                        <Label text="Titular" />
                        <Label fx:id="lbl_nome_titular" />
                        <Label text="Tipo" />
                        <Label fx:id="lbl_tipo_conta" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            <ListView fx:id="list_view_contas" minHeight="200.0" prefHeight="200.0" prefWidth="200.0" />
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="20.0">
               <children>
                  <TextField fx:id="valor_transferencia" />
                  <Button fx:id="btn_transferir" onAction="#transferir" mnemonicParsing="false" text="Transferir" >
                      <styleClass>
                          <String fx:value="btn" />
                          <String fx:value="btn-primary" />
                          <String fx:value="btn-sm" />
                      </styleClass>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
