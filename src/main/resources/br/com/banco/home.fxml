<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<SplitPane dividerPositions="0.19732441471571907" maxHeight="1.7976931348623157E308" orientation="VERTICAL" prefHeight="600.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.banco.screen.HomeController">

    <AnchorPane maxHeight="150.0" maxWidth="1.7976931348623157E308" prefHeight="150.0" SplitPane.resizableWithParent="false">
        <children>
         <VBox prefWidth="100.0" spacing="2.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                    <HBox nodeOrientation="LEFT_TO_RIGHT" spacing="20.0">
                        <children>
                            <Label text="Saldo:">
                                <font>
                                    <Font name="System Bold" size="15.0" />
                                </font>
                            </Label>
                            <Label fx:id="labelSaldo" text="" textFill="#574545" />
                        </children>
                  <padding>
                     <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                  </padding>
                    </HBox>
               <HBox spacing="20.0">
                  <children>

                            <Label text="Nome:">
                                <font>
                                    <Font name="System Bold" size="15.0" />
                                </font>
                            </Label>
                            <Label fx:id="labelNome" text="" textFill="#574545" />
                  </children>
                  <padding>
                     <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                  </padding>
               </HBox>
               <HBox spacing="20.0">
                  <children>

                            <Label text="Numero:">
                                <font>
                                    <Font name="System Bold" size="15.0" />
                                </font>
                            </Label>
                            <Label fx:id="labelConta" text="" textFill="#574545" />
                  </children>
                  <padding>
                     <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                  </padding>
               </HBox>
               <HBox layoutX="10.0" layoutY="88.0" spacing="20.0">
                  <children>
                     <Label text="Tipo:">
                        <font>
                           <Font name="System Bold" size="15.0" />
                        </font>
                     </Label>
                     <Label fx:id="labelTipoConta" text="" textFill="#574545" />
                  </children>
                  <padding>
                     <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                  </padding>
               </HBox>
            </children>
         </VBox>
        </children>

    </AnchorPane>

    <AnchorPane maxHeight="1.7976931348623157E308" prefHeight="500.0" SplitPane.resizableWithParent="false">
      <children>
         <HBox prefHeight="100.0" prefWidth="200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
               <TableView fx:id="tableTransacoes" prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS">
                 <columns>
                   <TableColumn fx:id="tbc_desc" prefWidth="75.0" text="Descrição" />
                   <TableColumn fx:id="tbc_operacao" prefWidth="75.0" text="Operação" />
                     <TableColumn fx:id="tbc_valor" prefWidth="75.0" text="Valor" />
                     <TableColumn fx:id="tbc_data" prefWidth="75.0" text="Data" />
                 </columns>
                  <columnResizePolicy>
                     <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                  </columnResizePolicy>
               </TableView>
               <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="25.0">
                  <children>

                     <Button mnemonicParsing="false" onAction="#depositar" text="Depositar">
                          <styleClass>
                              <String fx:value="btn" />
                              <String fx:value="btn-primary" />
                              <String fx:value="btn-sm" />
                          </styleClass>
                      </Button>

                     <Button mnemonicParsing="false" onAction="#sacar" text="Sacar">
                          <styleClass>
                              <String fx:value="btn" />
                              <String fx:value="btn-warning" />
                              <String fx:value="btn-sm" />
                          </styleClass>
                      </Button>

                     <Button fx:id="btn_transferir" mnemonicParsing="false" onAction="#transferir" text="Transferir">
                          <styleClass>
                              <String fx:value="btn" />
                              <String fx:value="btn-warning" />
                              <String fx:value="btn-sm" />
                          </styleClass>
                      </Button>

                     <Button mnemonicParsing="false" onAction="#logout" text="Sair">
                          <styleClass>
                              <String fx:value="btn" />
                              <String fx:value="btn-danger" />
                              <String fx:value="btn-sm" />
                          </styleClass>
                      </Button>

                  </children>
               </VBox>
            </children>
         </HBox>
      </children></AnchorPane>


</SplitPane>
